+async def _quota_guard(db: AsyncSession, workspace_id: int | None):
+    if not workspace_id:
+        return
+    ws = await db.get(EvalWorkspace, workspace_id)
+    if not ws:
+        raise HTTPException(400, "宸ヤ綔绌洪棿涓嶅瓨鍦?)
+    if ws.quota_tokens and ws.used_tokens >= ws.quota_tokens:
+        raise HTTPException(400, "宸ヤ綔绌洪棿 Token 閰嶉宸茬敤灏?)
+    if ws.quota_calls and ws.used_calls >= ws.quota_calls:
+        raise HTTPException(400, "宸ヤ綔绌洪棿璋冪敤娆℃暟閰嶉宸茬敤灏?)
+    tok_ratio = ws.used_tokens / ws.quota_tokens if ws.quota_tokens else 0
+    if tok_ratio >= 0.8:
+        from app.models import Notification
+        db.add(Notification(user_id=None, title="閰嶉棰勮", message=f"宸ヤ綔绌洪棿 {ws.name} Token 浣跨敤宸茶揪 {tok_ratio:.0%}", type="warning"))
