{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eval-platform:agent-plan:1.0",
  "title": "Agent Plan Draft 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "version", "goal", "mode", "resources", "nodes", "budget", "risk", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "format": "uuid"},
    "version": {"type": "integer", "minimum": 1},
    "goal": {"type": "string", "minLength": 1, "maxLength": 10000},
    "mode": {"enum": ["trial", "formal"]},
    "resources": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/resource"}},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/node"}},
    "budget": {"$ref": "#/$defs/budget"},
    "risk": {"enum": ["low", "medium", "high"]},
    "evidence_refs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "kind", "id", "version", "content_hash"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "kind": {"enum": ["dataset", "model", "prompt", "judge", "benchmark"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_total_tokens", "max_cost_micros", "currency", "max_active_seconds", "max_tool_calls"],
      "properties": {
        "max_total_tokens": {"type": "integer", "minimum": 1},
        "max_cost_micros": {"type": "integer", "minimum": 1},
        "currency": {"const": "CNY"},
        "max_active_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "kind", "depends_on", "config", "success_criteria"],
      "properties": {
        "node_id": {"$ref": "#/$defs/key"},
        "kind": {"enum": ["evaluation", "analysis", "report"]},
        "depends_on": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}},
        "config": {"type": "object"},
        "success_criteria": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "evaluation"}}}, "then": {"properties": {"config": {"$ref": "#/$defs/evaluation"}}}},
        {"if": {"properties": {"kind": {"const": "analysis"}}}, "then": {"properties": {"config": {"$ref": "#/$defs/analysis"}}}},
        {"if": {"properties": {"kind": {"const": "report"}}}, "then": {"properties": {"config": {"$ref": "#/$defs/report"}}}}
      ]
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_key", "model_key", "judge_key", "benchmark_key", "sample_limit", "seed", "repeat"],
      "properties": {
        "dataset_key": {"$ref": "#/$defs/key"}, "model_key": {"$ref": "#/$defs/key"},
        "judge_key": {"$ref": "#/$defs/key"}, "benchmark_key": {"$ref": "#/$defs/key"},
        "prompt_key": {"$ref": "#/$defs/key"},
        "sample_limit": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "seed": {"type": "integer", "minimum": 0}, "repeat": {"type": "integer", "minimum": 1, "maximum": 20}
      }
    },
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_role", "input_nodes"],
      "properties": {
        "agent_role": {"enum": ["evaluation_analyst", "diagnostician", "report_reviewer"]},
        "input_nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["input_nodes", "formats"],
      "properties": {
        "input_nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}},
        "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["json", "md", "csv", "xlsx", "docx", "html", "pdf"]}}
      }
    }
  }
}
