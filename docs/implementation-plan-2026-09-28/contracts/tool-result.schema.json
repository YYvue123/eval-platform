{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eval-platform:tool-result:1.0",
  "title": "Internal Tool Result 1.0",
  "type": "object", "additionalProperties": false,
  "required": ["status", "invocation_id", "data", "error", "evidence_refs", "artifact_refs", "usage"],
  "properties": {
    "status": {"enum": ["success", "error", "pending"]},
    "invocation_id": {"type": "string", "format": "uuid"},
    "data": {"type": ["object", "null"]},
    "error": {"oneOf": [
      {"type": "null"},
      {"type": "object", "additionalProperties": false, "required": ["code", "message", "retryable", "details"],
        "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "retryable": {"type": "boolean"}, "details": {"type": "object"}}}
    ]},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "artifact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "usage": {"oneOf": [
      {"type": "null"},
      {"type": "object", "additionalProperties": false,
        "required": ["prompt_tokens", "completion_tokens", "total_tokens", "model", "measurement_status"],
        "properties": {
          "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
          "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
          "total_tokens": {"type": ["integer", "null"], "minimum": 0},
          "model": {"type": "string", "minLength": 1},
          "measurement_status": {"enum": ["measured", "pending_reconciliation"]}
        }}
    ]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "error"}}}, "then": {"properties": {"error": {"type": "object"}, "data": {"type": "null"}}}},
    {"if": {"properties": {"status": {"enum": ["success", "pending"]}}}, "then": {"properties": {"error": {"type": "null"}, "data": {"type": "object"}}}}
  ]
}
