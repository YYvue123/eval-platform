{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eval-platform.example.com/schemas/manifest-v1.3.json",
  "title": "Eval Platform Resource Manifest V1.3",
  "type": "object",
  "required": [
    "spec_version",
    "resource_id",
    "resource_type",
    "name",
    "version",
    "description",
    "owner",
    "capabilities",
    "interfaces"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9]{1,32}/[a-z0-9_]{1,64}$",
      "description": "namespace<=32 chars, name<=64 chars"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "tool",
        "agent",
        "mcp",
        "skill",
        "datasource",
        "api",
        "model",
        "agent_mut",
        "eval_kit"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "owner": {
      "type": "object",
      "required": [
        "name",
        "contact"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 20
    },
    "capabilities": {
      "type": "object",
      "required": [
        "input_schema",
        "output_schema",
        "call_mode",
        "idempotent",
        "timeout"
      ],
      "properties": {
        "input_schema": {
          "type": "object"
        },
        "output_schema": {
          "type": "object"
        },
        "call_mode": {
          "type": "string",
          "enum": [
            "sync",
            "async",
            "stream",
            "batch"
          ]
        },
        "idempotent": {
          "type": "boolean"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "retryable": {
          "type": "boolean",
          "default": false
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evaluation_spec": {
      "type": "object",
      "description": "Evaluation spec (required for eval resources)",
      "required": [
        "judge_type",
        "metric_names"
      ],
      "properties": {
        "judge_type": {
          "type": "string",
          "enum": [
            "llm_judge",
            "regex",
            "exact_match",
            "fuzzy",
            "custom"
          ]
        },
        "reference_output": {
          "type": "object"
        },
        "metric_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "judge_prompt_template": {
          "type": "string"
        },
        "judge_model": {
          "type": "string"
        },
        "pass_threshold": {
          "type": "object",
          "description": "Keys MUST strictly match metric_names array elements"
        },
        "scoring_rubric": {
          "type": "string"
        }
      }
    },
    "interfaces": {
      "type": "object"
    },
    "permissions": {
      "type": "object",
      "properties": {
        "network_egress": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_access": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool_access": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource_quota": {
          "type": "object"
        }
      }
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "description",
          "reversible"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "write_fs",
              "http_call",
              "email",
              "db_write",
              "payment",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "reversible": {
            "type": "boolean"
          },
          "mock_strategy": {
            "type": "string",
            "enum": [
              "dry_run",
              "stub",
              "record"
            ]
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        },
        "gpu": {
          "type": "string"
        },
        "timeout": {
          "type": "integer"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "health_check": {
          "type": "object"
        },
        "graceful_shutdown": {
          "type": "object",
          "properties": {
            "timeout": {
              "type": "integer",
              "default": 30
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
