# 复制为 .env 并修改相应配置
# cp .env.example .env

# JWT 密钥，生产环境必须修改为 ≥24 字符的强随机值（APP_ENV=production 时拒绝本示例值）
SECRET_KEY=eval-platform-secret-key-change-in-production
# APP_ENV=production
# ADMIN_BOOTSTRAP_PASSWORD=replace-me-not-admin123

# L3 真实模型（写入 backend/.env，勿提交）
# L3_MODEL_API_URL=https://api.deepseek.com
# L3_MODEL_API_KEY=
# L3_MODEL_PRIMARY=deepseek-chat
# L3_MODEL_SECONDARY=
# L3_MODEL_CHANNEL=https
# L3_MCP_ENDPOINT=http://127.0.0.1:8765/mcp

# 数据库连接（SQLite 默认）
DATABASE_URL=sqlite+aiosqlite:///./eval_platform.db

# 上传目录（头像等）
UPLOAD_DIR=./uploads

# 日志目录
LOG_DIR=./logs
LOG_LEVEL=DEBUG
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
BACKUP_DIR=./backups

# 外部客户可自行注册模型接口的精确 HTTPS 域名白名单，逗号分隔；空值拒绝注册。
SERVICE_MODEL_HOSTS=
