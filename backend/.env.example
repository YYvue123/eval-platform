# 复制为 .env 并修改相应配置
# cp .env.example .env

# JWT 密钥，生产环境必须修改
SECRET_KEY=eval-platform-secret-key-change-in-production

# 数据库连接（SQLite 默认）
DATABASE_URL=sqlite+aiosqlite:///./eval_platform.db

# 上传目录（头像等）
UPLOAD_DIR=./uploads

# 日志目录
LOG_DIR=./logs
LOG_LEVEL=DEBUG
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
